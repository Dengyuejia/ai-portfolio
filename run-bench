#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
作业 2 的复现脚本：用同一组学科问题对比两个不同量级的 Ollama 模型。
只依赖 Python 标准库。用法：
    python run_bench.py qwen2.5:0.5b qwen2.5:3b
输出：
    experiments/raw/<模型名>.json   —— 逐题原始回答与计时
    experiments/summary.csv         —— 每个模型的汇总指标
所有题目的 system prompt、temperature(0)、seed(42)、num_predict、num_ctx
完全一致，只有模型不同。
"""
from __future__ import annotations
import csv
import json
import os
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime
HOST = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434").rstrip("/")
if "://" not in HOST:
    HOST = "http://" + HOST
HERE = os.path.dirname(os.path.abspath(__file__))
RAW_DIR = os.path.join(HERE, "raw")
CFG = json.load(open(os.path.join(HERE, "questions.json"), encoding="utf-8"))
QUESTIONS = CFG["questions"]
SYSTEM = CFG["meta"]["system_prompt"]
OPTIONS = CFG["meta"]["options"]
KEEP_ALIVE = "15m"
def api(path: str, payload: dict | None = None, timeout: int = 900) -> dict:
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        HOST + path, data=data, headers={"Content-Type": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))
def loaded_models() -> list[dict]:
    return api("/api/ps").get("models", [])
def unload(model: str) -> None:
    try:
        api("/api/generate", {"model": model, "keep_alive": 0}, timeout=120)
    except Exception as exc:  # noqa: BLE001 - 卸载失败不影响主流程
        print(f"[warn] unload {model}: {exc}")
def tag_info(model: str) -> dict:
    for m in api("/api/tags").get("models", []):
        if m.get("name") == model or m.get("model") == model:
            return m
    return {}
def run_model(model: str) -> dict:
    print(f"\n=== {model} ===")
    info = tag_info(model)
    # 预热：只用来把模型加载进内存，不计入正式成绩
    t0 = time.time()
    api(
        "/api/chat",
        {
            "model": model,
            "messages": [{"role": "user", "content": "你好"}],
            "stream": False,
            "options": OPTIONS,
            "keep_alive": KEEP_ALIVE,
        },
    )
    cold_load_s = time.time() - t0
    print(f"预热完成，加载+首答 {cold_load_s:.1f}s")
    time.sleep(1)
    ps = [m for m in loaded_models() if model.split(":")[0] in m.get("name", "")]
    mem = ps[0] if ps else {}
    rows = []
    for q in QUESTIONS:
        payload = {
            "model": model,
            "messages": [
                {"role": "system", "content": SYSTEM},
                {"role": "user", "content": q["prompt"]},
            ],
            "stream": False,
            "options": OPTIONS,
            "keep_alive": KEEP_ALIVE,
        }
        t0 = time.time()
        try:
            r = api("/api/chat", payload)
            wall = time.time() - t0
            text = r.get("message", {}).get("content", "")
            eval_count = r.get("eval_count", 0) or 0
            eval_ns = r.get("eval_duration", 0) or 1
            rows.append(
                {
                    "id": q["id"],
                    "subject": q["subject"],
                    "prompt": q["prompt"],
                    "expected": q["expected"],
                    "answer": text,
                    "wall_s": round(wall, 2),
                    "eval_count": eval_count,
                    "tok_per_s": round(eval_count / (eval_ns / 1e9), 2) if eval_count else 0,
                    "total_duration_s": round(r.get("total_duration", 0) / 1e9, 2),
                    "load_duration_s": round(r.get("load_duration", 0) / 1e9, 2),
                    "prompt_eval_count": r.get("prompt_eval_count", 0),
                }
            )
            print(f"  {q['id']} {q['subject']}: {rows[-1]['tok_per_s']:5.1f} tok/s, {wall:5.1f}s")
        except Exception as exc:  # noqa: BLE001
            rows.append(
                {
                    "id": q["id"],
                    "subject": q["subject"],
                    "prompt": q["prompt"],
                    "expected": q["expected"],
                    "answer": f"[ERROR] {exc}",
                    "wall_s": None,
                    "eval_count": 0,
                    "tok_per_s": 0,
                    "total_duration_s": None,
                    "load_duration_s": None,
                    "prompt_eval_count": 0,
                }
            )
            print(f"  {q['id']} 失败: {exc}")
    ok = [r for r in rows if r["wall_s"]]
    summary = {
        "model": model,
        "digest": info.get("digest", ""),
        "disk_size": info.get("size", 0),
        "param_size": info.get("details", {}).get("parameter_size", ""),
        "quant": info.get("details", {}).get("quantization_level", ""),
        "loaded_size": mem.get("size", 0),
        "loaded_vram": mem.get("size_vram", 0),
        "context": mem.get("context_length", 0),
        "cold_load_s": round(cold_load_s, 2),
        "avg_tok_per_s": round(sum(r["tok_per_s"] for r in ok) / len(ok), 2) if ok else 0,
        "avg_wall_s": round(sum(r["wall_s"] for r in ok) / len(ok), 2) if ok else 0,
        "total_mem_footprint": (mem.get("size", 0) or 0),
        "measured_at": datetime.now().isoformat(timespec="seconds"),
    }
    return {"summary": summary, "rows": rows}
def main(models: list[str]) -> int:
    os.makedirs(RAW_DIR, exist_ok=True)
    results = {}
    for model in models:
        results[model] = run_model(model)
        safe = model.replace(":", "_").replace("/", "_")
        with open(os.path.join(RAW_DIR, f"{safe}.json"), "w", encoding="utf-8") as f:
            json.dump(results[model], f, ensure_ascii=False, indent=2)
        unload(model)
    csv_path = os.path.join(HERE, "summary.csv")
    with open(csv_path, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.writer(f)
        w.writerow(
            [
                "model",
                "parameter_size",
                "quant",
                "disk_size_MB",
                "loaded_size_MB",
                "loaded_vram_MB",
                "cold_load_s",
                "avg_tok_per_s",
                "avg_wall_s",
            ]
        )
        for model, res in results.items():
            s = res["summary"]
            w.writerow(
                [
                    s["model"],
                    s["param_size"],
                    s["quant"],
                    round(s["disk_size"] / 1e6),
                    round(s["loaded_size"] / 1e6),
                    round(s["loaded_vram"] / 1e6),
                    s["cold_load_s"],
                    s["avg_tok_per_s"],
                    s["avg_wall_s"],
                ]
            )
    print(f"\n汇总已写入 {csv_path}")
    return 0
if __name__ == "__main__":
    args = sys.argv[1:] or ["qwen2.5:0.5b", "qwen2.5:3b"]
    raise SystemExit(main(args))
